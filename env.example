DATABASE_URL=postgresql://user:password@host/database?sslmode=require
PACK_AUTH_HMAC_SECRET=replace-with-at-least-32-random-bytes
PACK_AUTH_RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
PACK_AUTH_KEY_ID=pack-key-1
PACK_AUTH_ISS=https://pack-auth.example.com
PACK_AUTH_REVOCATION_WINDOW_DAYS=7
PACK_AUTH_MAX_NONCES_PER_WALLET=10
PACK_AUTH_MAX_USES=1000000
PACK_AUTH_MAX_VALIDITY_SECONDS=315360000
PACK_AUTH_SSL_NO_VERIFY=false
PACK_AUTH_ALLOWED_ORIGIN=http://localhost:3001
PACK_AUTH_SESSION_TTL_SECONDS=2592000
# Local HTTP only. Set true in every HTTPS deployment.
PACK_AUTH_COOKIE_SECURE=false
